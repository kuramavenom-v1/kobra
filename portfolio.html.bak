<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Korda | أعمالنا</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

    <!-- الهيدر الاحترافي -->
    <header class="header">
        <div class="container">
            <a href="index.html" class="logo">Korda</a>
            <nav class="nav-links">
                <a href="index.html" class="nav-link">الرئيسية</a>
                <a href="about.html" class="nav-link">من نحن</a>
                <a href="services.html" class="nav-link">الخدمات</a>
                <a href="portfolio.html" class="nav-link active">الأعمال</a>
                <a href="team.html" class="nav-link">الفريق</a>
            </nav>
            <div class="header-controls">
                <a href="index-en.html" class="btn-lang">EN</a>
                <a href="services.html" class="btn-primary">تواصل معنا</a>
            </div>
        </div>
    </header>

    <!-- بانر الصفحة -->
    <section class="page-banner">
        <div class="container">
            <h1>أعمالنا ومشاريعنا</h1>
            <p>نخبة من المشاريع التقنية والرقمية التي نفذناها باحترافية عالية</p>
        </div>
    </section>

    <!-- شبكة المشاريع -->
    <section class="section-padding">
        <div class="container">
            <div class="grid">
                <!-- المشروع الأول -->
                <div class="card">
                    <img src="images/portfolio/project1.jpg" alt="منصة تعليمية إلكترونية" style="width: 100%; height: 200px; object-fit: cover; border-radius: 4px; margin-bottom: 20px; border: 1px solid var(--border);">
                    <h3>منصة تعليمية إلكترونية</h3>
                    <p>برمجة وتطوير منصة متكاملة للتعليم عن بعد مع نظام إدارة تعلم متطور (LMS) ولوحة تحكم شاملة.</p>
                </div>

                <!-- المشروع الثاني -->
                <div class="card">
                    <img src="images/portfolio/project2.jpg" alt="تطبيق توصيل طلبات" style="width: 100%; height: 200px; object-fit: cover; border-radius: 4px; margin-bottom: 20px; border: 1px solid var(--border);">
                    <h3>تطبيق توصيل طلبات</h3>
                    <p>تطبيق جوال ذكي يربط بين المتاجر والمناديب والعملاء مع تتبع الطلبات بشكل مباشر وسريع.</p>
                </div>

                <!-- المشروع الثالث -->
                <div class="card">
                    <img src="images/portfolio/project3.jpg" alt="نظام إدارة موارد الشركات" style="width: 100%; height: 200px; object-fit: cover; border-radius: 4px; margin-bottom: 20px; border: 1px solid var(--border);">
                    <h3>نظام إدارة موارد الشركات</h3>
                    <p>نظام سحابي متكامل لإدارة الحسابات، والمستودعات، والموارد البشرية للشركات الكبرى.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- الفوتر الرسمي -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <p>&copy; 2026 Korda. جميع الحقوق محفوظة.</p>
                <div class="footer-links">
                    <a href="privacy.html">سياسة الخصوصية</a>
                    <a href="terms.html">الشروط والأحكام</a>
                </div>
            </div>
        </div>
    </footer>

</body>
</html>
