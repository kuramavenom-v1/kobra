<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Korda | تفاصيل الخدمة</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

  <!-- الهيدر الاحترافي -->
<header class="header">
    <div class="container">
        <a href="index.html" class="logo">☂ Korda</a>
        
        <!-- روابط سطح المكتب العادية -->
        <nav class="nav-links">
            <a href="index.html" class="nav-link">الرئيسية</a>
            <a href="about.html" class="nav-link">من نحن</a>
            <a href="services.html" class="nav-link active">الخدمات</a>
            <a href="portfolio.html" class="nav-link">الأعمال</a>
            <a href="team.html" class="nav-link">الفريق</a>
            <a href="contact.html" class="nav-link">اتصل بنا</a>
        </nav>

        <div class="header-controls">
            <!-- زر الوضع الليلي/النهاري -->
            <button class="theme-toggle-btn" id="themeToggleBtn" title="تغيير الوضع">🌙</button>

            <a href="contact.html" class="btn-primary" style="display: none; @media(min-width: 768px){display:inline-block;}">تواصل معنا</a>
            
            <!-- زر القائمة الجانبية للجوال -->
            <button class="menu-toggle" id="openMenuBtn">☰</button>
        </div>
    </div>
</header>

<!-- القائمة الجانبية المنبثقة للجوال (Drawer) -->
<div class="mobile-menu" id="mobileMenu">
    <div>
        <div class="mobile-menu-header">
            <a href="index.html" class="logo" style="font-size: 20px;">Korda</a>
            <button class="close-menu" id="closeMenuBtn">&times;</button>
        </div>
        
        <ul class="mobile-nav-links">
            <li><a href="index.html">الرئيسية</a></li>
            <li><a href="about.html">من نحن</a></li>
            <li><a href="services.html">خدماتنا</a></li>
            <li><a href="portfolio.html">أعمالنا</a></li>
            <li><a href="team.html">فريق العمل</a></li>
            <li><a href="contact.html">اتصل بنا</a></li>
        </ul>
    </div>

    <div class="mobile-footer-info">
        <div class="mobile-contact-item">📞 +966553910586</div>
        <div class="mobile-contact-item">✉️ info@korda.com</div>
        <div class="mobile-socials">
            <a href="#">G</a>
            <a href="#">W</a>
            <a href="#">T</a>
            <a href="#">A</a>
        </div>
        <a href="contact.html" class="btn-primary" style="text-align: center; margin-top: 10px;">طلب خدمة</a>
    </div>
</div>

<!-- سكريبت تشغيل وإغلاق القائمة -->
<script>
    const openMenuBtn = document.getElementById('openMenuBtn');
    const closeMenuBtn = document.getElementById('closeMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');

    openMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.add('active');
    });

    closeMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.remove('active');
    });
</script>

    <!-- بانر الصفحة -->
    <section class="page-banner">
        <div class="container">
            <h1>تفاصيل الخدمة أو المشروع</h1>
            <p>نظرة شاملة وعميقة على الآلية والتقنيات المستخدمة في التنفيذ</p>
        </div>
    </section>

    <!-- تفاصيل المشروع/الخدمة -->
    <section class="section-padding">
        <div class="container">
            <div style="max-width: 900px; margin: 0 auto;">
                <!-- صورة تفصيلية رئيسية -->
                <img src="images/services/service-detail.jpg" alt="تفاصيل الخدمة" style="width: 100%; height: 400px; object-fit: cover; border-radius: 6px; margin-bottom: 30px; border: 1px solid var(--border);">
                
                <h2 style="font-size: 28px; margin-bottom: 20px;">منهجية العمل والحلول المقدمة</h2>
                <p style="opacity: 0.8; margin-bottom: 20px; line-height: 1.8;">نقدم في Korda استراتيجيات مدروسة بعناية لتلبية متطلبات عملائنا بدقة تامة. نبدأ بتحليل الاحتياجات التقنية بدقة، مروراً بمرحلة التصميم وهندسة البرمجيات، وصولاً إلى الاختبار الشامل والإطلاق الرسمي.</p>
                
                <p style="opacity: 0.8; margin-bottom: 30px; line-height: 1.8;">نضمن لك أعلى مستويات الأمان، وسرعة الأداء، وقابلية التوسع المستقبلي لتواكب طموحات شركتك وتطلعات عملائك.</p>

                <div style="display: flex; gap: 15px; margin-top: 40px;">
                    <a href="services.html" class="btn-outline">العودة للخدمات</a>
                    <a href="contact.html" class="btn-primary">اطلب استشارة مجانية</a>
                </div>
            </div>
        </div>
    </section>

    <!-- الفوتر الرسمي -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <p>&copy; 2026 Korda.</p>
                <div class="footer-links">
                    <a href="privacy.html">سياسة الخصوصية</a>
                    <a href="terms.html">الشروط والأحكام</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- سكريبت الوضع الليلي / النهاري -->
    <script>
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        const currentTheme = localStorage.getItem('theme') || 'dark';

        if (currentTheme === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
            if (themeToggleBtn) themeToggleBtn.textContent = '☀️';
        } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            if (themeToggleBtn) themeToggleBtn.textContent = '🌙';
        }

        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', () => {
                let theme = document.documentElement.getAttribute('data-theme');
                if (theme === 'light') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                    localStorage.setItem('theme', 'dark');
                    themeToggleBtn.textContent = '🌙';
                } else {
                    document.documentElement.setAttribute('data-theme', 'light');
                    localStorage.setItem('theme', 'light');
                    themeToggleBtn.textContent = '☀️';
                }
            });
        }
    </script>

</body>
</html>
