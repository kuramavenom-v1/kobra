<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Korda | خدماتنا</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

<!-- الهيدر الاحترافي -->
<header class="header">
    <div class="container">
        <a href="index.html" class="logo">☂ Korda</a>
        
        <!-- روابط سطح المكتب العادية -->
        <nav class="nav-links">
            <a href="index.html" class="nav-link">الرئيسية</a>
            <a href="about.html" class="nav-link">من نحن</a>
            <a href="services.html" class="nav-link active">الخدمات</a>
            <a href="portfolio.html" class="nav-link">الأعمال</a>
            <a href="team.html" class="nav-link">الفريق</a>
            <a href="contact.html" class="nav-link">اتصل بنا</a>
        </nav>

        <div class="header-controls">
            <!-- زر الوضع الليلي/النهاري -->
            <button class="theme-toggle-btn" id="themeToggleBtn" title="تغيير الوضع">🌙</button>

            <a href="contact.html" class="btn-primary" style="display: none; @media(min-width: 768px){display:inline-block;}">تواصل معنا</a>
            
            <!-- زر القائمة الجانبية للجوال -->
            <button class="menu-toggle" id="openMenuBtn">☰</button>
        </div>
    </div>
</header>

<!-- القائمة الجانبية المنبثقة للجوال (Drawer) -->
<div class="mobile-menu" id="mobileMenu">
    <div>
        <div class="mobile-menu-header">
            <a href="index.html" class="logo" style="font-size: 20px;">Korda</a>
            <button class="close-menu" id="closeMenuBtn">&times;</button>
        </div>
        
        <ul class="mobile-nav-links">
            <li><a href="index.html">الرئيسية</a></li>
            <li><a href="about.html">من نحن</a></li>
            <li><a href="services.html">خدماتنا</a></li>
            <li><a href="portfolio.html">أعمالنا</a></li>
            <li><a href="team.html">فريق العمل</a></li>
            <li><a href="contact.html">اتصل بنا</a></li>
        </ul>
    </div>

    <div class="mobile-footer-info">
        <div class="mobile-contact-item">📞 +966553910586</div>
        <div class="mobile-contact-item">✉️ info@korda.com</div>
        <div class="mobile-socials">
            <a href="#">G</a>
            <a href="#">W</a>
            <a href="#">T</a>
            <a href="#">A</a>
        </div>
        <a href="contact.html" class="btn-primary" style="text-align: center; margin-top: 10px;">طلب خدمة</a>
    </div>
</div>

<!-- سكريبت تشغيل وإغلاق القائمة -->
<script>
    const openMenuBtn = document.getElementById('openMenuBtn');
    const closeMenuBtn = document.getElementById('closeMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');

    openMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.add('active');
    });

    closeMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.remove('active');
    });
</script>

    <!-- بانر الصفحة -->
    <section class="page-banner">
        <div class="container">
            <h1>خدماتنا التقنية</h1>
            <p>نقدم حلولاً رقمية متكاملة مصممة خصيصاً لتطوير أعمالك ونموها</p>
        </div>
    </section>

    <!-- شبكة الخدمات -->
    <section class="section-padding">
        <div class="container">
            <div class="grid">
                <!-- الخدمة الأولى -->
                <div class="card">
                    <img src="images/services/web-dev.jpg" alt="تطوير الويب" style="width: 100%; height: 200px; object-fit: cover; border-radius: 4px; margin-bottom: 20px; border: 1px solid var(--border);">
                    <h3>تطوير الويب والمنصات</h3>
                    <p>تصميم وبرمجة مواقع الإنترنت وتطبيقات الويب السحابية بأحدث التقنيات العالمية وبأداء فائق السرعة.</p>
                </div>

                <!-- الخدمة الثانية -->
                <div class="card">
                    <img src="images/services/mobile-app.jpg" alt="تطبيقات الهواتف الذكية" style="width: 100%; height: 200px; object-fit: cover; border-radius: 4px; margin-bottom: 20px; border: 1px solid var(--border);">
                    <h3>تطبيقات الهواتف الذكية</h3>
                    <p>تطوير تطبيقات الجوال لأنظمة (iOS و Android) بتجربة استخدام سلسة وتصميم عصري يواكب احتياجات عملائك.</p>
                </div>

                <!-- الخدمة الثالثة -->
                <div class="card">
                    <img src="images/services/digital-solutions.jpg" alt="الاستشارات والحلول التقنية" style="width: 100%; height: 200px; object-fit: cover; border-radius: 4px; margin-bottom: 20px; border: 1px solid var(--border);">
                    <h3>الاستشارات والحلول التقنية</h3>
                    <p>نساعد الشركات في التخطيط للتحول الرقمي، دراسة البنية التحتية، وتقديم استشارات برمجية ترفع من كفاءة العمل.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- الفوتر الرسمي -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <p>&copy; 2026 Korda</p>
                <div class="footer-links">
                    <a href="privacy.html">سياسة الخصوصية</a>
                    <a href="terms.html">الشروط والأحكام</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- سكريبت الوضع الليلي / النهاري -->
    <script>
        const themeToggleBtn = document.getElementById('themeToggleBtn');
        const currentTheme = localStorage.getItem('theme') || 'dark';

        if (currentTheme === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
            if (themeToggleBtn) themeToggleBtn.textContent = '☀️';
        } else {
            document.documentElement.setAttribute('data-theme', 'dark');
            if (themeToggleBtn) themeToggleBtn.textContent = '🌙';
        }

        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', () => {
                let theme = document.documentElement.getAttribute('data-theme');
                if (theme === 'light') {
                    document.documentElement.setAttribute('data-theme', 'dark');
                    localStorage.setItem('theme', 'dark');
                    themeToggleBtn.textContent = '🌙';
                } else {
                    document.documentElement.setAttribute('data-theme', 'light');
                    localStorage.setItem('theme', 'light');
                    themeToggleBtn.textContent = '☀️';
                }
            });
        }
    </script>

</body>
</html>
