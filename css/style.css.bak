/* ==========================================
   ملف التنسيقات الشامل Korda CSS (محدث للتحكم بالهواتف)
   ========================================== */

:root {
    --bg-color: #0f172a;
    --text-color: #f8fafc;
    --card-bg: #1e293b;
    --border: #334155;
    --primary: #3b82f6;
    --primary-hover: #2563eb;
    --secondary: #94a3b8;
    --header-bg: rgba(15, 23, 42, 0.95);
}

[data-theme="light"] {
    --bg-color: #f8fafc;
    --text-color: #0f172a;
    --card-bg: #ffffff;
    --border: #e2e8f0;
    --primary: #2563eb;
    --primary-hover: #1d4ed8;
    --secondary: #64748b;
    --header-bg: rgba(248, 250, 252, 0.95);
}

/* منع التحريك الأفقي وثبات الشاشة تماماً على الجوال */
html, body {
    width: 100%;
    max-width: 100vw;
    overflow-x: hidden;
    box-sizing: border-box;
}

* {
    box-sizing: inherit;
    margin: 0;
    padding: 0;
    font-family: system-ui, -apple-system, sans-serif;
}

body {
    background-color: var(--bg-color);
    color: var(--text-color);
    transition: background-color 0.3s ease, color 0.3s ease;
    direction: rtl;
    text-align: right;
}

.container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 15px;
}

/* الهيدر الاحترافي المتجاوب */
.header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--header-bg);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
    padding: 12px 0;
    width: 100%;
}

.header .container {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.logo {
    font-size: 22px;
    font-weight: bold;
    color: var(--text-color);
    text-decoration: none;
    white-space: nowrap;
}

/* روابط سطح المكتب الافتراضية (مخفية تلقائياً على الجوال وتظهر بالشاشات الكبيرة) */
.nav-links {
    display: none; 
}

.header-controls {
    display: flex;
    align-items: center;
    gap: 10px;
}

/* زر الوضع الليلي/النهاري */
.theme-toggle-btn {
    background: var(--card-bg);
    border: 1px solid var(--border);
    color: var(--text-color);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    transition: transform 0.2s;
}

.theme-toggle-btn:hover {
    transform: scale(1.05);
}

/* الأزرار العامة */
.btn-primary {
    background-color: var(--primary);
    color: #ffffff;
    padding: 8px 16px;
    border-radius: 6px;
    text-decoration: none;
    font-weight: 500;
    font-size: 14px;
    transition: background-color 0.2s;
    white-space: nowrap;
}

.btn-primary:hover {
    background-color: var(--primary-hover);
}

/* زر القائمة الجانبية (الهامبرجر) يظهر دائماً في الجوال */
.menu-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--border);
    color: var(--text-color);
    font-size: 20px;
    width: 38px;
    height: 38px;
    border-radius: 6px;
    cursor: pointer;
}

/* الشبكات والكروت لتجنب الخروج عن حدود الشاشة للجوال */
.grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 20px;
    width: 100%;
}

.card {
    background-color: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    width: 100%;
    word-wrap: break-word;
}

.page-banner {
    padding: 40px 15px;
    text-align: center;
    background: var(--card-bg);
    border-bottom: 1px solid var(--border);
}

/* القائمة الجانبية للجوال (Drawer) */
.mobile-menu {
    position: fixed;
    top: 0;
    right: -100%;
    width: 270px;
    max-width: 80vw;
    height: 100%;
    background-color: var(--card-bg);
    border-left: 1px solid var(--border);
    z-index: 1100;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
    transition: right 0.3s ease;
    box-shadow: -5px 0 25px rgba(0,0,0,0.5);
}

.mobile-menu.active {
    right: 0;
}

.mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 25px;
}

.close-menu {
    background: none;
    border: none;
    color: var(--text-color);
    font-size: 30px;
    cursor: pointer;
    line-height: 1;
}

.mobile-nav-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.mobile-nav-links a {
    color: var(--text-color);
    text-decoration: none;
    font-size: 16px;
    display: block;
    padding: 6px 0;
    border-bottom: 1px solid var(--border);
}

.mobile-footer-info {
    border-top: 1px solid var(--border);
    padding-top: 15px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13px;
    color: var(--secondary);
}

.footer {
    background-color: var(--card-bg);
    border-top: 1px solid var(--border);
    padding: 25px 15px;
    text-align: center;
    margin-top: 40px;
    width: 100%;
}

.footer-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: center;
}

.footer-links {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
    justify-content: center;
}

.footer-links a {
    color: var(--secondary);
    text-decoration: none;
    font-size: 13px;
}

/* التنسيق للشاشات الأكبر (الكمبيوتر والآيباد 768 بكسل فأكثر) */
@media (min-width: 768px) {
    .nav-links {
        display: flex;
        gap: 20px;
    }
    
    .menu-toggle {
        display: none;
    }

    .grid {
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    }
}
