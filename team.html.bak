<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Korda | فريق العمل</title>
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="css/responsive.css">
</head>
<body>

    <!-- Header -->
    <header class="header">
        <div class="container">
            <a href="index.html" class="logo">Korda<span>.</span></a>
            <nav class="nav">
                <ul>
                    <li><a href="index.html">الرئيسية</a></li>
                    <li><a href="about.html">من نحن</a></li>
                    <li><a href="services.html">الخدمات</a></li>
                    <li><a href="portfolio.html">الأعمال</a></li>
                    <li><a href="team.html">الفريق</a></li>
                </ul>
            </nav>
            <a href="service-details.html" class="btn btn-primary">تواصل معنا</a>
        </div>
    </header>

    <!-- Page Banner -->
    <div class="page-banner">
        <div class="container">
            <h1>فريق العمل</h1>
            <p>نخبة من المبدعين والخبراء في العالم الرقمي</p>
        </div>
    </div>

    <!-- Team Grid -->
    <section class="section-padding">
        <div class="container">
            <div class="grid">
                <!-- العضو 1 -->
                <div class="card team-card">
                    <div style="width: 150px; height: 150px; background: #e2e8f0; border-radius: 50%; margin: 0 auto 15px; border: 3px solid var(--primary); display: flex; align-items: center; justify-content: center; color: #94a3b8;">صورة</div>
                    <h3>أحمد محمد</h3>
                    <p style="color: var(--primary); font-weight: bold; margin-bottom: 10px;">المدير التنفيذي</p>
                    <p>خبير في استراتيجيات الأعمال وتطوير المنتجات الرقمية بخبرة تتجاوز 10 سنوات.</p>
                </div>
                <!-- العضو 2 -->
                <div class="card team-card">
                    <div style="width: 150px; height: 150px; background: #e2e8f0; border-radius: 50%; margin: 0 auto 15px; border: 3px solid var(--primary); display: flex; align-items: center; justify-content: center; color: #94a3b8;">صورة</div>
                    <h3>سارة خالد</h3>
                    <p style="color: var(--primary); font-weight: bold; margin-bottom: 10px;">مديرة التسويق الرقمي</p>
                    <p>متخصصة في بناء العلامات التجارية وقيادة الحملات التسويقية الناجحة.</p>
                </div>
                <!-- العضو 3 -->
                <div class="card team-card">
                    <div style="width: 150px; height: 150px; background: #e2e8f0; border-radius: 50%; margin: 0 auto 15px; border: 3px solid var(--primary); display: flex; align-items: center; justify-content: center; color: #94a3b8;">صورة</div>
                    <h3>عمر عبدالله</h3>
                    <p style="color: var(--primary); font-weight: bold; margin-bottom: 10px;">مهندس برمجيات (Full-Stack)</p>
                    <p>مهووس بكتابة الأكواد النظيفة وبناء أنظمة الويب المعقدة وعالية الأداء.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-bottom">
                <p>كوردا معكم ل حياه افضل 🌙</p>
            </div>
        </div>
    </footer>

</body>
</html>
