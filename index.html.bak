<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Korda | الرئيسية</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

<!-- الهيدر الاحترافي -->
<header class="header">
    <div class="container">
        <a href="index.html" class="logo">Korda</a>
        
        <!-- روابط سطح المكتب العادية -->
        <nav class="nav-links">
            <a href="index.html" class="nav-link active">الرئيسية</a>
            <a href="about.html" class="nav-link">من نحن</a>
            <a href="services.html" class="nav-link">الخدمات</a>
            <a href="portfolio.html" class="nav-link">الأعمال</a>
            <a href="team.html" class="nav-link">الفريق</a>
            <a href="contact.html" class="nav-link">اتصل بنا</a>
        </nav>

        <div class="header-controls">
            <a href="contact.html" class="btn-primary" style="display: none; @media(min-width: 768px){display:inline-block;}">تواصل معنا</a>
            
            <!-- زر القائمة الجانبية للجوال -->
            <button class="menu-toggle" id="openMenuBtn">☰</button>
        </div>
    </div>
</header>

<!-- القائمة الجانبية المنبثقة للجوال (Drawer) -->
<div class="mobile-menu" id="mobileMenu">
    <div>
        <div class="mobile-menu-header">
            <a href="index.html" class="logo" style="font-size: 20px;">Korda</a>
            <button class="close-menu" id="closeMenuBtn">&times;</button>
        </div>
        
        <ul class="mobile-nav-links">
            <li><a href="index.html">الرئيسية</a></li>
            <li><a href="about.html">من نحن</a></li>
            <li><a href="services.html">خدماتنا</a></li>
            <li><a href="portfolio.html">أعمالنا</a></li>
            <li><a href="team.html">فريق العمل</a></li>
            <li><a href="contact.html">اتصل بنا</a></li>
        </ul>
    </div>

        <div class="mobile-footer-info">
        <div class="mobile-contact-item">📞 +966553910586</div>
        <div class="mobile-contact-item">✉️ info@korda.com</div>
        <div class="mobile-socials">
            <a href="#">G</a>
            <a href="#">W</a>
            <a href="#">T</a>
            <a href="#">A</a>
        </div>
        <a href="contact.html" class="btn-primary" style="text-align: center; margin-top: 10px;">طلب خدمة</a>
    </div>
</div>

<!-- سكريبت تشغيل وإغلاق القائمة -->
<script>
    const openMenuBtn = document.getElementById('openMenuBtn');
    const closeMenuBtn = document.getElementById('closeMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');

    openMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.add('active');
    });

    closeMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.remove('active');
    });
</script>

    <!-- قسم Hero الرئيسي مع الصورة الواسعة بالأسفل -->
    <section class="hero">
        <div class="container">
            <h1>نبتكر حلولاً تقنية ترسم مستقبل عملك</h1>
            <p>وكالة رقمية متكاملة تقدم أحدث تقنيات الويب وتطوير البرمجيات للشركات الطموحة.</p>
            <div class="hero-buttons" style="margin-bottom: 50px;">
                <a href="portfolio.html" class="btn-primary">استعرض أعمالنا</a>
                <a href="about.html" class="btn-outline">تعرف علينا</a>
            </div>

            <!-- الصورة المضافة أسفل الأزرار بنفس ستايل الكروت الواسعة والواضحة -->
            <div style="max-width: 900px; margin: 0 auto; border-radius: 8px; overflow: hidden; border: 1px solid var(--border); background-color: var(--card-bg);">
                <img src="images/hero-main.jpg" alt="حلول Korda التقنية" style="width: 100%; height: 380px; object-fit: cover; display: block;">
            </div>
        </div>
    </section>

    <!-- قسم مميزات الشركة -->
    <section class="section-padding">
        <div class="container">
            <h2 class="section-title">لماذا اختيار Korda</h2>
            <div class="grid">
                <div class="card">
                    <h3>احترافية عالية</h3>
                    <p>نلتزم بأعلى معايير الجودة العالمية في تسليم المشاريع البرمجية في وقتها المحدد.</p>
                </div>
                <div class="card">
                    <h3>تصميم عصري</h3>
                    <p>واجهات مستخدم تجمع بين جمالية التصميم وسلاسة التجربة لضمان رضا عملائك.</p>
                </div>
                <div class="card">
                    <h3>دعم مستمر</h3>
                    <p>فريق فني متكامل جاهز لتقديم الدعم والصيانة وتطوير نظامك بشكل مستمر.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- الفوتر الرسمي -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <p>&copy; 2026 Korda. جميع الحقوق محفوظة.</p>
                <div class="footer-links">
                    <a href="privacy.html">سياسة الخصوصية</a>
                    <a href="terms.html">الشروط والأحكام</a>
                </div>
            </div>
        </div>
    </footer>

</body>
</html>
