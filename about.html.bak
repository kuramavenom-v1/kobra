<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Korda | من نحن</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

   <!-- الهيدر الاحترافي -->
<header class="header">
    <div class="container">
        <a href="index.html" class="logo">☂ Kohaaaa</a>
        
        <!-- روابط سطح المكتب العادية -->
        <nav class="nav-links">
            <a href="index.html" class="nav-link">الرئيسية</a>
            <a href="about.html" class="nav-link">من نحن</a>
            <a href="services.html" class="nav-link">الخدمات</a>
            <a href="portfolio.html" class="nav-link">الأعمال</a>
            <a href="team.html" class="nav-link">الفريق</a>
        </nav>

        <div class="header-controls">
            <a href="services.html" class="btn-primary" style="display: none; @media(min-width: 768px){display:inline-block;}">تواصل معنا</a>
            
            <!-- زر القائمة الجانبية للجوال -->
            <button class="menu-toggle" id="openMenuBtn">☰</button>
        </div>
    </div>
</header>

<!-- القائمة الجانبية المنبثقة للجوال (Drawer) -->
<div class="mobile-menu" id="mobileMenu">
    <div>
        <div class="mobile-menu-header">
            <a href="index.html" class="logo" style="font-size: 20px;">Korda</a>
            <button class="close-menu" id="closeMenuBtn">&times;</button>
        </div>
        
        <ul class="mobile-nav-links">
            <li><a href="index.html">الرئيسية</a></li>
            <li><a href="about.html">من نحن</a></li>
            <li><a href="services.html">خدماتنا</a></li>
            <li><a href="portfolio.html">أعمالنا</a></li>
            <li><a href="team.html">فريق العمل</a></li>
            <li><a href="services.html">اتصل بنا</a></li>
        </ul>
    </div>

        <div class="mobile-footer-info">
        <div class="mobile-contact-item">📞 +966553910586</div>
        <div class="mobile-contact-item">✉️ info@korda.com</div>
        <div class="mobile-socials">
            <a href="#">G</a>
            <a href="#">W</a>
            <a href="#">T</a>
            <a href="#">A</a>
        </div>
        <a href="services.html" class="btn-primary" style="text-align: center; margin-top: 10px;">طلب خدمة</a>
    </div>
</div>

<!-- سكريبت تشغيل وإغلاق القائمة -->
<script>
    const openMenuBtn = document.getElementById('openMenuBtn');
    const closeMenuBtn = document.getElementById('closeMenuBtn');
    const mobileMenu = document.getElementById('mobileMenu');

    openMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.add('active');
    });

    closeMenuBtn.addEventListener('click', () => {
        mobileMenu.classList.remove('active');
    });
</script>

    <!-- بانر الصفحة -->
    <section class="page-banner">
        <div class="container">
            <h1>من نحن</h1>
            <p>تعرف على قصتنا ورؤيتنا في قيادة التحول الرقمي</p>
        </div>
    </section>

    <!-- محتوى صفحة من نحن -->
    <section class="section-padding">
        <div class="container">
            <div class="about-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 40px; align-items: center;">
                <div>
                    <img src="images/about/company-overview.jpg" alt="مكتب شركة Korda" style="width: 100%; border-radius: 8px; border: 1px solid var(--border);">
                </div>
                <div>
                    <h2 style="font-size: 28px; margin-bottom: 20px;">نحن وكالة تقنية متكاملة</h2>
                    <p style="opacity: 0.8; margin-bottom: 15px; line-height: 1.8;">بدأت Korda كفكرة طموحة لتمكين الشركات من الدخول إلى العالم الرقمي بقوة وثبات. نجمع بين الإبداع البرمجي والتصميم العصري لنقدم حلولاً تُحدث فارقاً حقيقياً في أعمال عملائنا.</p>
                    <p style="opacity: 0.8; line-height: 1.8;">نؤمن بأن الجودة والالتزام هما أساس النجاح المستدام، ولذلك نحرص على بناء علاقات طويلة الأمد تعتمد على الثقة والاحترافية المطلقة.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- قسم الرؤية والرسالة -->
    <section class="section-padding" style="background-color: var(--card-bg);">
        <div class="container">
            <div class="grid">
                <div class="card">
                    <h3>رؤيتنا</h3>
                    <p>أن نكون الشريك التقني الأول والموثوق للشركات الباحثة عن الابتكار والريادة في الشرق الأوسط.</p>
                </div>
                <div class="card">
                    <h3>رسالتنا</h3>
                    <p>تقديم حلول برمجية عالية الأداء، قابلة للتطوير، وتلبي احتياجات السوق بدقة واحترافية.</p>
                </div>
                <div class="card">
                    <h3>قيمنا</h3>
                    <p>الشفافية المطلقة، الالتزام بالمعايير العالمية، التركيز على تحقيق أهداف العميل.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- الفوتر الرسمي -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <p>&copy; 2026 Korda. جميع الحقوق محفوظة.</p>
                <div class="footer-links">
                    <a href="privacy.html">سياسة الخصوصية</a>
                    <a href="terms.html">الشروط والأحكام</a>
                </div>
            </div>
        </div>
    </footer>

</body>
</html>
